{
  "name": "albino",
  "version": "0.3.0",
  "description": "Personal productivity plugin: brings Rashad's workflows to Cursor.",
  "author": {
    "name": "Rashad Ansari",
    "url": "https://github.com/RashadAnsari"
  },
  "hooks": {
    "version": 1,
    "hooks": {
      "sessionStart": [
        {
          "command": "PLATFORM=cursor bash \"${CURSOR_PLUGIN_ROOT}/hooks/session-start.sh\""
        }
      ]
    }
  }
}
